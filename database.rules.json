{
  "rules": {
    "courses": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')"
    },
    "metrics": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')"
    },
    "scenarios": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')"
    },
    "missions": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')"
    },
    "certificates": {
      ".read": true,
      "$certId": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "progress": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "telemetry": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "attempts": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "questions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "last_access": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).child('profile/role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid && newData.isNumber()"
      }
    },
    "operator": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('operator').child(auth.uid).val() === true"
    },
    "operator_settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('operator').child(auth.uid).val() === true"
    }
  }
}
